<mvc:View controllerName="com.test.cvamenares.controller.Main"
    xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:core="sap.ui.core" displayBlock="true">
    <Page showHeader="false" enableScrolling="true">
        <FlexBox wrap="Wrap" class="cvLayout">
            <VBox class="cvSide">
                <layoutData>
                    <FlexItemData baseSize="20rem" growFactor="0" shrinkFactor="0"/>
                </layoutData>
                <Panel headerText="Datos Contacto">
                    <Text text="{view>/contacto}" renderWhitespace="true"/>
                </Panel>
                <Button text="Descargar CV (PDF)" icon="sap-icon://download" type="Emphasized"
                    press=".onDescargar" class="cvBtnPdf"/>
                <FlexBox wrap="Wrap" class="cvTiles">
                    <GenericTile header="Resumen Profesional" mode="IconMode" frameType="TwoByHalf"
                        tileIcon="sap-icon://notes" press=".onTile" class="cvTile">
                        <customData><core:CustomData key="file" value="res_prof.txt"/></customData>
                    </GenericTile>
                    <GenericTile header="Fortalezas" mode="IconMode" frameType="TwoByHalf"
                        tileIcon="sap-icon://favorite" press=".onTile" class="cvTile">
                        <customData><core:CustomData key="file" value="habilidades.txt"/></customData>
                    </GenericTile>
                    <GenericTile header="Certificaciones" mode="IconMode" frameType="TwoByHalf"
                        tileIcon="sap-icon://education" press=".onTile" class="cvTile">
                        <customData><core:CustomData key="file" value="educacion.txt"/></customData>
                    </GenericTile>
                    <GenericTile header="Historial laboral" mode="IconMode" frameType="TwoByHalf"
                        tileIcon="sap-icon://history" press=".onTile" class="cvTile">
                        <customData><core:CustomData key="file" value="experiencia.txt"/></customData>
                    </GenericTile>
                    <GenericTile header="Referencias" mode="IconMode" frameType="TwoByHalf"
                        tileIcon="sap-icon://group" press=".onTile" class="cvTile">
                        <customData><core:CustomData key="file" value="referencias.json"/></customData>
                    </GenericTile>
                </FlexBox>
            </VBox>
            <Panel id="panelContenido" headerText="{view>/titulo}" class="cvMain">
                <layoutData>
                    <FlexItemData baseSize="24rem" growFactor="1" minWidth="0"/>
                </layoutData>
                <Text text="{view>/texto}" renderWhitespace="true" visible="{view>/esTexto}"/>
                <Table items="{view>/referencias}" visible="{view>/esTabla}">
                    <columns>
                        <Column><Text text="Nombre"/></Column>
                        <Column minScreenWidth="Tablet" demandPopin="true"><Text text="Cargo"/></Column>
                        <Column minScreenWidth="Tablet" demandPopin="true"><Text text="Email"/></Column>
                        <Column minScreenWidth="Tablet" demandPopin="true"><Text text="Teléfono"/></Column>
                    </columns>
                    <items>
                        <ColumnListItem>
                            <Text text="{view>nombre}"/>
                            <Text text="{view>cargo}"/>
                            <Text text="{view>email}"/>
                            <Text text="{view>telefono}"/>
                        </ColumnListItem>
                    </items>
                </Table>
            </Panel>
        </FlexBox>
    </Page>
</mvc:View>
